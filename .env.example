# Copy this file to `.env` and fill in the values. `.env` is ignored by git: never commit secrets.

# LLM (free): create a key at https://console.groq.com -> API Keys
LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# Local alternative (Ollama): LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen3:8b

# Email channel: the LunaGo Gmail address + a 16-character Google *App Password*
# (Google Account -> Security -> 2-Step Verification -> App passwords)
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# Where the public website runs (used in links inside reply emails)
# PUBLIC_BASE_URL=http://localhost:3000
