# Copy this file to `.env` and fill in the values. `.env` is ignored by git: never commit secrets.

# LLM (free): create a key at https://console.groq.com -> API Keys
LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# Local alternative (Ollama): LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen3:8b

# Email channel, two options:
# 1. A free mail.tm inbox, no sign-up, receive only: `uv run complaintlens inbox-create lunagocare`
#    prints the three lines to paste here.
# EMAIL_INBOX=mailtm
# 2. Any IMAP/SMTP mailbox, which also sends replies, e.g. Gmail with a 16-character App Password
#    (Google Account -> Security -> 2-Step Verification -> App passwords).
# EMAIL_INBOX=imap
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# Console sign-in: the first administrator, created at startup if no account exists yet. Without a
# password it is admin / admin (fine locally, never on a server). Then add people on the Team page.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# Shared secret of the community-forum relay (GitHub Actions secret CHANNEL_TOKEN, same value).
# CHANNEL_TOKEN=

# Where the public website runs (used in tracking links)
# PUBLIC_BASE_URL=http://localhost:3000
# Browser origins allowed to call the API besides localhost:3000 (comma-separated)
# CORS_ORIGINS=https://kirazul.github.io
